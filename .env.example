# Copia este archivo a .env.local y completa los valores.

# Client ID de OAuth (tipo "Aplicación web") de Google Cloud. No es secreto: viaja al navegador.
# Guía: docs/GOOGLE_SETUP.md
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# API key de Groq para el asistente (solo servidor: SIN prefijo NEXT_PUBLIC_).
# https://console.groq.com/keys
GROQ_API_KEY=

# Backend (food-rutine-api): login, sincronización y avisos push.
NEXT_PUBLIC_API_URL=https://api.tu-dominio.com
